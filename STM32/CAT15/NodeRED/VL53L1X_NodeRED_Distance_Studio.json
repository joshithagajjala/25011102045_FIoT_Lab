  {
    "id": "tof_mqtt_v1",
    "type": "mqtt in",
    "z": "tof_flow_v1",
    "name": "VL53L1X Live MQTT",
    "topic": "stm32/tof/data",
    "qos": "0",
    "datatype": "auto-detect",
    "broker": "tof_broker_v1",
    "nl": false,
    "rap": true,
    "rh": 0,
    "inputs": 0,
    "x": 150,
